# PreCex - L3 样本 s03 (counter_alu) SymbiYosys 配置：对 buggy 版运行 BMC，期望 Assert failed（A6 击穿）
# 作者：Toylog | 版本：v0.2 | 功能概述：read -sv -formal 单文件（断言已内联于 buggy.sv，参照 smoke/counter.sby 模式）
#        + prep -top counter_alu + smtbmc(z3) BMC，depth 270
# 运行方式（WSL）：
#   export PATH=/home/toylog/.local/bin:/usr/local/bin:/usr/bin:/bin
#   export SMTBMC=/mnt/d/BaiduSyncdisk/02_Precex/smoke/yosys-smtbmc-z3.sh
#   sby -f verify.sby -d <workdir>
# 预期：DONE FAIL（counterexample），反例约在第 256 拍 A6 断言失败（cnt 达 255 后下一拍回绕为 1 而非 0）
# 说明：depth 需覆盖 255 拍计数 + 1 拍断言（复位后 cnt 从 0 连续使能 255 拍到 255，再 1 拍回绕判定）

[tasks]
bmc

[options]
bmc: mode bmc
bmc: depth 270
bmc: timeout 5400

[engines]
bmc: smtbmc

[script]
read -sv -formal buggy.sv
prep -top counter_alu

[files]
buggy.sv
